[Unit]
Description=PAIR/SPY public read-only liquidity dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pairdash
Group=pairdash
WorkingDirectory=/opt/pair-liquidity-dashboard/current
Environment=NODE_ENV=production
Environment=PAIR_DASHBOARD_HOST=127.0.0.1
Environment=PAIR_DASHBOARD_PORT=8080
Environment=PAIR_DASHBOARD_REFRESH_MS=15000
Environment=PAIR_DASHBOARD_RETRIES=2
Environment=PAIR_DASHBOARD_STATE_DIR=/var/lib/pair-liquidity-dashboard
EnvironmentFile=/etc/pair-liquidity-dashboard.env
ExecStart=/usr/bin/node --no-warnings dashboard/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pair-liquidity-dashboard
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
LimitNOFILE=4096
MemoryMax=1G

[Install]
WantedBy=multi-user.target
